    {
      "id": "N3Iqv5KgXuGilTu0H9qIE",
      "type": "text",
      "x": 190.19935579432774,
      "y": 15342.449636587342,
      "width": 2164.4990234375,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4a",
      "roundness": null,
      "seed": 221831467,
      "version": 885,
      "versionNonce": 770860965,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779291122351,
      "link": null,
      "locked": false,
      "text": "Final Important things  LongURL to ShortURL and ViceVersa Redirections :- \n\nGenerally redirection success it throws 301 or 302 statusCodes. Exact difference between those two codes is ...\n\n1) 301 status code :- Stores this URL re-direction details in Brower cache. With this requests won't come to our server and it\n    store details in browser cache. With this we can decrese traffic in our service. \n  \n                                         Other side is ......\n\n2) 302 status code :- Always request comes to server. So that it has always updated value like if any expire happens will get to know.\n     If you want to count number of requests coming to our server implement this 302 away.  Ask interviewer which one he wants.",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Final Important things  LongURL to ShortURL and ViceVersa Redirections :- \n\nGenerally redirection success it throws 301 or 302 statusCodes. Exact difference between those two codes is ...\n\n1) 301 status code :- Stores this URL re-direction details in Brower cache. With this requests won't come to our server and it\n    store details in browser cache. With this we can decrese traffic in our service. \n  \n                                         Other side is ......\n\n2) 302 status code :- Always request comes to server. So that it has always updated value like if any expire happens will get to know.\n     If you want to count number of requests coming to our server implement this 302 away.  Ask interviewer which one he wants.",
      "autoResize": true,
      "lineHeight": 1.25
    },
