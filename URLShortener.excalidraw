    {
      "id": "fmfeeNMsnSrXloBh9gd5M",
      "type": "text",
      "x": 57.603413516883734,
      "y": 5504.573794638427,
      "width": 2513.33935546875,
      "height": 180,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b19",
      "roundness": null,
      "seed": 2094437093,
      "version": 305,
      "versionNonce": 1836094475,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779287943695,
      "link": null,
      "locked": false,
      "text": "Here very critical problem is we have only single instance of Redis cluster, if this goes down entire system goes down. So we main 2 to 3 clusters with this \nanother problem  is each cluster having Counter variable again may leads to duplciate counter value.\n\nThis problem we can solve using Zookeeper technique. ",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here very critical problem is we have only single instance of Redis cluster, if this goes down entire system goes down. So we main 2 to 3 clusters with this \nanother problem  is each cluster having Counter variable again may leads to duplciate counter value.\n\nThis problem we can solve using Zookeeper technique. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oul97cKLkcBppc4FDM3uR",
