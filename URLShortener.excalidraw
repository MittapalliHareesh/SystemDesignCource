      "seed": 1386306917,
      "version": 184,
      "versionNonce": 1806022891,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779287943695,
      "link": null,
      "locked": false,
      "text": "Here 3 applications registered with Zookeeper.\n\nAnd each application stores data in 2 ways. \n\n    A) Persistenet Node\n    B) Emphemeral Node",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here 3 applications registered with Zookeeper.\n\nAnd each application stores data in 2 ways. \n\n    A) Persistenet Node\n    B) Emphemeral Node",
      "autoResize": true,
      "lineHeight": 1.25
    },
