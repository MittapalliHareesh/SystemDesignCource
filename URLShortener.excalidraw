      "seed": 3985259,
      "version": 223,
      "versionNonce": 1542808459,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779287943695,
      "link": null,
      "locked": false,
      "text": "Here Persistenet node is perment and it exists even after restart applications \nbut emphemeral node will go wipped out after server restart / server dies.\n\n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here Persistenet node is perment and it exists even after restart applications \nbut emphemeral node will go wipped out after server restart / server dies.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
