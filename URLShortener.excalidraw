    {
      "id": "5uWYFJH5dqc7PhgggA9VX",
      "type": "text",
      "x": 127.02999047766161,
      "y": 8597.575200109943,
      "width": 2548.798828125,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
