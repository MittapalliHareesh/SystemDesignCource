      "seed": 584956363,
      "version": 632,
      "versionNonce": 829462667,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779287943695,
      "link": null,
      "locked": false,
      "text": "1) Given long form of URL \n       a) we will encrypt it , think it takes 1 ms   { like ...  gh3266nd }\n       b) check this shorteren URL present or not in DB , if yes return that mapped longURL. ......lets say all this operation takes 10ms\n       c) After DB scan if no long url exists then save this new URL in db...lets say this takes 5ms. \n\n------Overall to perform above operation took 16ms. For each shortenURL\n  \n",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Given long form of URL \n       a) we will encrypt it , think it takes 1 ms   { like ...  gh3266nd }\n       b) check this shorteren URL present or not in DB , if yes return that mapped longURL. ......lets say all this operation takes 10ms\n       c) After DB scan if no long url exists then save this new URL in db...lets say this takes 5ms. \n\n------Overall to perform above operation took 16ms. For each shortenURL\n  \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
