      "updated": 1779287943695,
      "link": null,
      "locked": false,
      "text": "3) Using Zookeeper: -",
      "fontSize": 78.69461165233805,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3) Using Zookeeper: -",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pvyAK7XEbzD2tbRlAQAu2",
      "type": "text",
      "x": 86.89464193733306,
      "y": 7414.797315717626,
      "width": 1737.107421875,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b21",
      "roundness": null,
      "seed": 556684907,
      "version": 590,
      "versionNonce": 1211311339,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779287943695,
      "link": null,
      "locked": false,
      "text": "Basically Zookeeper is a distributed, Open source coordination service for distributed applications. \n\nProviding centralized services for configuration management , naming,  synchronization and group services \nmaking it easier to manager  large clusters.\n    \n            Used for :  Maintaing configuration information, naming, distributed locking, group service, \n                               distributed synchronization ...etc. \n\n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Basically Zookeeper is a distributed, Open source coordination service for distributed applications. \n\nProviding centralized services for configuration management , naming,  synchronization and group services \nmaking it easier to manager  large clusters.\n    \n            Used for :  Maintaing configuration information, naming, distributed locking, group service, \n                               distributed synchronization ...etc. \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
