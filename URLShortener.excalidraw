    {
      "id": "tEYfLgWT7CGtMX8TubZWb",
      "type": "text",
      "x": 54.331452414375576,
      "y": 5344.2857764646,
      "width": 2564.746826171875,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
