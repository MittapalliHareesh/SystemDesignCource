    {
      "id": "i1ZpOiH93y2VQI1mwLX-Q",
      "type": "text",
      "x": 1617.74106959523,
      "y": 8286.290234772896,
      "width": 1251.935546875,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
