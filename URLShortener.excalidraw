      "seed": 1473231109,
      "version": 288,
      "versionNonce": 104249899,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779287943695,
      "link": null,
      "locked": false,
      "text": "Will see implemention now with help of Zookeeper ....  Here mainly will create Zookeeper and we keep the counter variable in the zookeeper persistent node.\nso that anyway this won't be cleared out. \n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Will see implemention now with help of Zookeeper ....  Here mainly will create Zookeeper and we keep the counter variable in the zookeeper persistent node.\nso that anyway this won't be cleared out. \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
