    {
      "id": "hDCl1bowzUoT4Xtk60zge",
      "type": "text",
      "x": 65.09058573595075,
      "y": 3056.5539363104012,
      "width": 1645.894775390625,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
