    {
      "id": "DHREZmWIiUAiSphxFeEUi",
      "type": "text",
      "x": 148.6259120629577,
      "y": 9707.27846443804,
      "width": 2207.5499550790023,
      "height": 152.02401015951364,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3P",
      "roundness": null,
      "seed": 711211211,
      "version": 64,
      "versionNonce": 989000459,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779287993705,
      "link": null,
      "locked": false,
      "text": "Whenever server register Zookeeper, individual application servers generate the 64-bit Snowflake ID completely offline. \nZooKeeper is used purely as a coordinator to assign each server a unique Machine ID (Worker ID) when they boot up, \nensuring no two machines share the same identifier. Apache ZooKeeper does not actually generate the Snowflake",
      "fontSize": 40.53973604253695,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Whenever server register Zookeeper, individual application servers generate the 64-bit Snowflake ID completely offline. \nZooKeeper is used purely as a coordinator to assign each server a unique Machine ID (Worker ID) when they boot up, \nensuring no two machines share the same identifier. Apache ZooKeeper does not actually generate the Snowflake",
      "autoResize": true,
      "lineHeight": 1.25
    },
