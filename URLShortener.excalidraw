      "isDeleted": false,
      "boundElements": null,
      "updated": 1779287943695,
      "link": null,
      "locked": false,
      "text": "Will see how we can register our application in Zookeeper ... \n                 Zookeeper registers different applications and data in the form graph structure. Computer directory format.\n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Will see how we can register our application in Zookeeper ... \n                 Zookeeper registers different applications and data in the form graph structure. Computer directory format.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
