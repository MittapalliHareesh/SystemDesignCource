      "updated": 1779287943695,
      "link": null,
      "locked": false,
      "text": "API's\n\n1)  POST: v1/url     {      --> return shortUrl\n                            longUrl,\n                            customUrl ?\n                            expirationDate ?\n                  }\n\n\n2) GET : v1/url/shortUrl --> return LongUrl",
      "fontSize": 21.175517493487618,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API's\n\n1)  POST: v1/url     {      --> return shortUrl\n                            longUrl,\n                            customUrl ?\n                            expirationDate ?\n                  }\n\n\n2) GET : v1/url/shortUrl --> return LongUrl",
      "autoResize": false,
      "lineHeight": 1.25
    },
